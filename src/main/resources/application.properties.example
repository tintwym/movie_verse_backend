spring.application.name=movie-verse-backend

# Neon PostgreSQL
# From the Neon dashboard → Connection details → JDBC (or convert the URI):
#   postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# → jdbc:postgresql://HOST/DB?sslmode=require
spring.datasource.url=jdbc:postgresql://<neon-host>/<database>?sslmode=require
spring.datasource.username=<username>
spring.datasource.password=<password>
spring.datasource.driver-class-name=org.postgresql.Driver

# Neon is serverless — keep the pool small
spring.datasource.hikari.maximum-pool-size=5
spring.datasource.hikari.connection-timeout=30000
spring.datasource.hikari.max-lifetime=300000

# Hibernate
spring.jpa.show-sql=true
spring.jpa.hibernate.ddl-auto=update
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# JWT — use a long random string (min 32 characters) in production
jwt.secret=<jwt_secret>
jwt.expiration=3600000

# CORS — comma-separated allowed frontend origins
cors.allowed-origins=http://localhost:3000

# Static Resources for public access
spring.web.resources.static-locations=classpath:/static/,classpath:/public/

# Session Timeout
server.servlet.session.timeout=30m
