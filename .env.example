# Copy to .env and fill in Neon credentials:
#   cp .env.example .env
#
# Neon dashboard → your project → Connection details
# Use the JDBC connection string (sslmode=require).
# If Neon shows: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# then:
#   SPRING_DATASOURCE_URL=jdbc:postgresql://HOST/DB?sslmode=require
#   SPRING_DATASOURCE_USERNAME=USER
#   SPRING_DATASOURCE_PASSWORD=PASSWORD

SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=your-neon-password

BACKEND_PORT=8080

JWT_SECRET=change-me-to-a-long-random-secret-key
JWT_EXPIRATION=3600000
